# Переменные сайта и API. На сервере лежат в /srv/prestige-logist/.env, в git не попадают.
# Файл нужен даже пустым: compose передаёт его в Dockerfile сайта секретом.

# Токен dadata: поиск адреса по ФИАС и реквизиты по ИНН. Без него всё заполняется руками.
DADATA_TOKEN=

# Sentry, проект prestige-logist: ошибки API и, при сборке, сайта. Пусто -- Sentry выключен.
SENTRY_DSN=
# DSN для браузера вшивается в сайт при сборке, он публичный.
PUBLIC_SENTRY_DSN=
