---
import Seo from '@aimuzov/infra-site-kit/seo.astro'
import '@fontsource-variable/inter'
import '@aimuzov/infra-site-kit/base.css'
import ThemeBoot from '@aimuzov/infra-site-kit/theme-boot.astro'
import '@aimuzov/infra-site-kit/ui/tokens.css'
import '#frontend/styles/global.css'
import SiteFooter from '#frontend/components/site-footer.astro'
import { site } from '#frontend/data/site.ts'
import { pageTitle } from '#frontend/lib/title.ts'

type Props = {
	/** Название страницы, к нему добавится название сайта. Без него — одно название сайта. */
	title?: string
	/** `meta description` и `og:description`, по умолчанию `site.description`. */
	description?: string
	/** `false` у служебных страниц вроде 404: без canonical и с запретом индексации. */
	index?: boolean
}

const { title, description = site.description, index = true } = Astro.props
const fullTitle = pageTitle(title)
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<Seo
			title={fullTitle}
			description={description}
			siteName={site.name}
			url={canonical}
			locale="ru_RU"
			type="website"
			canonical={index ? canonical : undefined}
			robots={index ? undefined : 'noindex'}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<!-- Блокирующий намеренно: тема должна встать до первой отрисовки. -->
		<ThemeBoot />
		<slot name="head" />
	</head>
	<body>
		<slot />
		<SiteFooter />
		<script>
			import { sentry } from '#frontend/lib/sentry.ts'
			void sentry()
		</script>
	</body>
</html>
